#[test_only]
module proof_of_run::proof_of_run_tests;

use proof_of_run::proof_of_run;

// Vectors generated by `npm run vectors` (lib/engine.ts). Both engines must agree.
#[test]
fun vector_bot_seed_123456789() {
    let jumps: vector<u16> = vector[25, 46, 66, 87, 104, 121, 144, 161, 183, 201, 223, 244, 267, 283, 306, 329, 346, 362, 386, 409, 427, 447, 471, 492, 512, 534, 559, 575, 597];
    assert!(proof_of_run::replay(123456789, &jumps) == 3400);
}

#[test]
fun vector_bot_seed_42() {
    let jumps: vector<u16> = vector[20, 39, 64, 81, 103, 122, 145, 161, 182, 203, 221, 241, 261, 285, 304, 322, 341, 360, 377, 400, 421, 445, 465, 485, 503, 520, 537, 558, 579];
    assert!(proof_of_run::replay(42, &jumps) == 3500);
}

#[test]
fun vector_early_death() {
    let jumps: vector<u16> = vector[1];
    assert!(proof_of_run::replay(42, &jumps) == 21);
}

#[test, expected_failure(abort_code = 1)]
fun unsorted_log_rejected() {
    let jumps: vector<u16> = vector[30, 10];
    proof_of_run::replay(42, &jumps);
}
