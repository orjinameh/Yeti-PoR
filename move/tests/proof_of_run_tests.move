#[test]
fun admin_grants_crown_and_daily_points_once_per_day() {
    let a = @0xA;
    let b = @0xB;
    let day = 20000;
    let mut sc = ts::begin(a);
    proof_of_run::init_for_testing(sc.ctx());

    sc.next_tx(a);
    {
        let cap = sc.take_from_sender<proof_of_run::AdminCap>();
        let mut reg = sc.take_shared<proof_of_run::Registry>();
        proof_of_run::grant_for_testing(&cap, &mut reg, 3, b, sc.ctx());
        sc.return_to_sender(cap);
        ts::return_shared(reg);
    };
    sc.next_tx(b);
    assert!(ts::has_most_recent_for_address<proof_of_run::Cosmetic>(b));

    // Two verified daily runs on the same day: points are awarded once.
    let seed = proof_of_run::daily_seed(day);
    let none: vector<u16> = vector[];
    let mut i = 0;
    while (i < 2) {
        sc.next_tx(a);
        proof_of_run::daily_run_for_testing(day, sc.ctx());
        sc.next_tx(a);
        {
            let mut board = sc.take_shared<proof_of_run::Leaderboard>();
            let mut reg = sc.take_shared<proof_of_run::Registry>();
            let run = sc.take_from_sender<proof_of_run::Run>();
            let score = proof_of_run::replay(seed, &none, &none);
            proof_of_run::submit_for_testing(&mut board, &mut reg, run, copy none, copy none, score, sc.ctx());
            // idle run dies, so 1 base point only
            assert!(proof_of_run::reward_points(&reg, a) == 1);
            ts::return_shared(board);
            ts::return_shared(reg);
        };
        i = i + 1;
    };
    sc.end();
}
