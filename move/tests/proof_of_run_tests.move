#[test_only]
module proof_of_run::proof_of_run_tests;

use proof_of_run::proof_of_run;

// Vectors generated by `npm run vectors` (lib/engine.ts). Both engines must agree.
#[test]
fun vector_bot_seed_123456789() {
    let jumps: vector<u16> = vector[25, 46, 144, 346];
    let shots: vector<u16> = vector[55, 58, 76, 79, 93, 96, 110, 113, 150, 172, 175, 190, 193, 212, 215, 233, 236, 256, 272, 275, 295, 318, 351, 354, 375, 378, 398, 401, 416, 419, 436, 439, 460, 463, 481, 484, 501, 523, 548, 564, 567, 586, 589];
    assert!(proof_of_run::replay(123456789, &jumps, &shots) == 4900);
}

#[test]
fun vector_bot_seed_42() {
    let jumps: vector<u16> = vector[20, 39, 81, 103, 122, 145, 161, 261, 285, 304, 377, 400, 421];
    let shots: vector<u16> = vector[53, 56, 171, 174, 192, 195, 210, 213, 230, 233, 311, 330, 349, 434, 454, 474, 492, 509, 526, 547, 550, 568, 593];
    assert!(proof_of_run::replay(42, &jumps, &shots) == 4600);
}

#[test]
fun vector_jump_only_seed_42() {
    let jumps: vector<u16> = vector[20, 39, 64, 81, 103, 122, 145, 161, 182, 203, 221, 241, 261, 285, 304, 322, 341, 360, 377, 400, 421, 445, 465];
    let shots: vector<u16> = vector[];
    assert!(proof_of_run::replay(42, &jumps, &shots) == 2666);
}

#[test]
fun vector_idle_seed_42() {
    let jumps: vector<u16> = vector[];
    let shots: vector<u16> = vector[];
    assert!(proof_of_run::replay(42, &jumps, &shots) == 504);
}

